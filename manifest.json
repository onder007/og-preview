{
  "manifest_version": 3,
  "name": "OG Preview",
  "version": "0.1.0",
  "description": "See which Open Graph tags need fixing and how the current page looks when shared on X, LinkedIn and WhatsApp.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "OG Preview",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["activeTab", "scripting"]
}
